<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Tree View -->
        <record id="view_medical_staff_tree" model="ir.ui.view">
            <field name="name">medical.staff.tree</field>
            <field name="model">medical.staff</field>
            <field name="arch" type="xml">
                <list string="Medical Staff">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="department"/>
                    <field name="phone_number"/>
                    <field name="email"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_medical_staff_form" model="ir.ui.view">
            <field name="name">medical.staff.form</field>
            <field name="model">medical.staff</field>
            <field name="arch" type="xml">
                <form string="Medical Staff">
                    <sheet>
                        <group>
                            <group string="Staff Information">
                                <field name="first_name"/>
                                <field name="last_name"/>
                                <field name="department"/>
                            </group>
                            <group string="Contact Information">
                                <field name="phone_number"/>
                                <field name="email"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_medical_staff_search" model="ir.ui.view">
            <field name="name">medical.staff.search</field>
            <field name="model">medical.staff</field>
            <field name="arch" type="xml">
                <search string="Search Medical Staff">
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="department"/>
                    <field name="email"/>
                    <separator/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_medical_staff" model="ir.actions.act_window">
            <field name="name">Medical Staff</field>
            <field name="res_model">medical.staff</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new medical staff record
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_medical_staff_root" 
                  name="Medical Staff" 
                  sequence="20"/>
        
        <menuitem id="menu_medical_staff_main" 
                  name="Medical Staff" 
                  parent="menu_medical_staff_root" 
                  action="action_medical_staff" 
                  sequence="10"/>

    </data>
</odoo>