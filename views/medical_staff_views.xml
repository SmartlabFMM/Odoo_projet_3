<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medical_staff_form" model="ir.ui.view">
        <field name="name">patient.monitoring.staff.form</field>
        <field name="model">patient.monitoring.staff</field>
        <field name="arch" type="xml">
            <form string="Medical Staff" class="hm_staff_form" create="0">
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_patients" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="patient_count" widget="statinfo" string="Patients"/>
                        </button>

                        <button name="action_reset_telegram" type="object"
                                class="oe_stat_button"
                                icon="fa-check-circle"
                                invisible="not telegram_linked"
                                confirm="This will unlink the staff member from Telegram. They will need to scan the QR code again to re-register. Continue?">
                            <div class="o_stat_info">
                                <span class="o_stat_value text-success">Linked</span>
                                <span class="o_stat_text">Telegram</span>
                            </div>
                        </button>

                        <div class="oe_stat_button" invisible="telegram_linked">
                            <i class="fa fa-fw fa-chain-broken o_button_icon" title="Telegram not linked"/>
                            <div class="o_stat_info">
                                <span class="o_stat_value text-muted">Not Linked</span>
                                <span class="o_stat_text">Telegram</span>
                            </div>
                        </div>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" placeholder="Full Name"/></h1>
                        <h3>
                            <field name="user_id"
                                   placeholder="Linked System User"
                                   options="{'no_create': True}"
                                   readonly="1"/>
                        </h3>
                    </div>

                    <group>
                        <group string="Professional Details">
                            <field name="employee_id" readonly="1"/>
                            <field name="specialization"/>
                            <field name="department"/>
                        </group>
                        <group string="Contact">
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>

                    <separator string="Telegram Alert Setup" invisible="not id"/>

                    <div class="hm_tg_telegram_row" invisible="not id">

                        <div class="hm_tg_left_col">
                            <field name="telegram_status_html"
                                   nolabel="1"
                                   widget="html"
                                   readonly="1"/>
                        </div>

                        <div class="hm_tg_right_col">

                            <div class="hm_tg_action_row" invisible="not telegram_linked">
                                <button name="action_reset_telegram"
                                        type="object"
                                        string="Unlink Telegram"
                                        class="btn hm_unlink_btn"
                                        confirm="This will unlink this staff member from Telegram. They will need to scan the QR code again to re-register. Continue?"/>
                            </div>

                            <div invisible="telegram_linked or not telegram_qr_code">
                                <field name="telegram_qr_code"
                                       widget="image"
                                       options="{'size': [220, 220]}"
                                       nolabel="1"
                                       readonly="1"
                                       class="hm_tg_qr_image"/>
                            </div>

                        </div>

                    </div>

                    <field name="telegram_chat_id"
                           string="Chat ID (auto-filled)"
                           readonly="1"
                           invisible="not telegram_chat_id"/>

                    <p class="text-center ps-3 hm_qr_hint"
                       invisible="not id or telegram_linked or not telegram_qr_code">
                        Scan the QR code above with your phone and Telegram opens automatically.
                        Tap <strong>Start</strong> once to complete registration.
                    </p>

                    <notebook invisible="not id">
                        <page string="Managed Patients" name="patients">
                            <field name="patient_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="age"/>
                                    <field name="sex"/>
                                    <field name="patient_ref"/>
                                    <field name="monitoring_status"
                                           string="Monitoring"
                                           widget="badge"
                                           decoration-success="monitoring_status == 'live'"
                                           decoration-secondary="monitoring_status == 'offline'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medical_staff_tree" model="ir.ui.view">
        <field name="name">patient.monitoring.staff.list</field>
        <field name="model">patient.monitoring.staff</field>
        <field name="arch" type="xml">
            <list string="Medical Staff" create="0">
                <field name="name"/>
                <field name="user_id" string="System User"/>
                <field name="employee_id"/>
                <field name="specialization"/>
                <field name="department"/>
                <field name="phone"/>
                <field name="telegram_linked"
                       string="Telegram"
                       widget="boolean_toggle"
                       readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_medical_staff_search" model="ir.ui.view">
        <field name="name">patient.monitoring.staff.search</field>
        <field name="model">patient.monitoring.staff</field>
        <field name="arch" type="xml">
            <search string="Search Medical Staff">
                <field name="name"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="department"/>
                <filter name="doctors"             string="Doctors"
                        domain="[('specialization','=','doctor')]"/>
                <filter name="nurses"              string="Nurses"
                        domain="[('specialization','=','nurse')]"/>
                <filter name="telegram_linked"     string="Telegram Linked"
                        domain="[('telegram_linked','=',True)]"/>
                <filter name="telegram_missing"    string="Telegram Not Set Up"
                        domain="[('telegram_linked','=',False)]"/>
                <separator/>
                <filter name="group_specialization" string="Specialization"
                        context="{'group_by':'specialization'}"/>
                <filter name="group_department"     string="Department"
                        context="{'group_by':'department'}"/>
            </search>
        </field>
    </record>

    <record id="action_medical_staff" model="ir.actions.act_window">
        <field name="name">Medical Staff</field>
        <field name="res_model">patient.monitoring.staff</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('user_id', '!=', False)]</field>
        <field name="search_view_id" ref="view_medical_staff_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No medical staff yet!
            </p>
            <p>
                Go to <strong>Settings → Users</strong>, open a user,
                and assign them the <strong>Medical Staff</strong> role.
                Their profile will appear here automatically.
            </p>
        </field>
    </record>

    <record id="action_medical_staff_overview" model="ir.actions.client">
        <field name="name">Medical Staff</field>
        <field name="tag">health_monitoring.medical_staff_dashboard</field>
    </record>

</odoo>