<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_medical_record_form" model="ir.ui.view">
        <field name="name">patient.monitoring.medical.record.form</field>
        <field name="model">patient.monitoring.medical.record</field>
        <field name="arch" type="xml">
            <form string="Medical Record">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_archive_record" string="Archive" type="object"
                        invisible="state != 'confirmed'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                        invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirmed,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Record Information">
                            <field name="patient_id"/>
                            <field name="date"/>
                            <field name="record_type"/>
                            <field name="attending_staff_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Clinical Details" name="details">
                            <group>
                                <field name="diagnosis"/>
                                <field name="treatment"/>
                                <field name="prescriptions"/>
                                <field name="notes"/>
                            </group>
                        </page>
                        <page string="Vital Thresholds" name="thresholds">
                            <group string="Heart Rate (bpm)">
                                <field name="min_heart_rate"/>
                                <field name="max_heart_rate"/>
                            </group>
                            <group string="Pulse (bpm)">
                                <field name="min_pulse"/>
                                <field name="max_pulse"/>
                            </group>
                            <group string="Oxygen Saturation (%)">
                                <field name="min_oxygen_saturation"/>
                                <field name="max_oxygen_saturation"/>
                            </group>
                            <group string="Respiratory Rate (/min)">
                                <field name="min_respiratory_rate"/>
                                <field name="max_respiratory_rate"/>
                            </group>
                            <group string="Temperature (°C)">
                                <field name="min_temperature"/>
                                <field name="max_temperature"/>
                            </group>
                        </page>
                        <page string="Measurements" name="measurements">
                            <field name="measurement_ids" widget="vitals_chart" nolabel="1"/>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachments" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_medical_record_tree" model="ir.ui.view">
        <field name="name">patient.monitoring.medical.record.tree</field>
        <field name="model">patient.monitoring.medical.record</field>
        <field name="arch" type="xml">
            <list string="Medical Records">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="date"/>
                <field name="record_type"/>
                <field name="attending_staff_id"/>
                <field name="state" widget="badge"
                    decoration-success="state=='confirmed'"
                    decoration-warning="state=='draft'"
                    decoration-muted="state=='archived'"/>
            </list>
        </field>
    </record>

    <record id="view_medical_record_search" model="ir.ui.view">
        <field name="name">patient.monitoring.medical.record.search</field>
        <field name="model">patient.monitoring.medical.record</field>
        <field name="arch" type="xml">
            <search string="Search Medical Records">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="attending_staff_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="archived_rec" string="Archived" domain="[('state','=','archived')]"/>
                <filter name="group_patient" string="Patient" context="{'group_by':'patient_id'}"/>
                <filter name="group_type" string="Record Type" context="{'group_by':'record_type'}"/>
                <filter name="group_date" string="Date" context="{'group_by':'date:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_medical_record" model="ir.actions.act_window">
        <field name="name">Medical Records</field>
        <field name="res_model">patient.monitoring.medical.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_medical_record_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first medical record!</p>
        </field>
    </record>

    <record id="action_report_medical_record" model="ir.actions.report">
        <field name="name">Medical Record Report</field>
        <field name="model">patient.monitoring.medical.record</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">health_monitoring.report_medical_record</field>
        <field name="report_file">health_monitoring.report_medical_record</field>
        <field name="binding_model_id" ref="model_patient_monitoring_medical_record"/>
        <field name="binding_type">report</field>
    </record>
</odoo>