<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Tree View -->
        <record id="view_vital_sign_tree" model="ir.ui.view">
            <field name="name">patient.vital.sign.tree</field>
            <field name="model">patient.vital.sign</field>
            <field name="arch" type="xml">
                <list string="Vital Signs">
                    <field name="type"/>
                    <field name="normal_min_range"/>
                    <field name="normal_max_range"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_vital_sign_form" model="ir.ui.view">
            <field name="name">patient.vital.sign.form</field>
            <field name="model">patient.vital.sign</field>
            <field name="arch" type="xml">
                <form string="Vital Sign">
                    <sheet>
                        <group>
                            <group string="Vital Sign Information">
                                <field name="type"/>
                                <field name="normal_min_range"/>
                                <field name="normal_max_range"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_vital_sign_search" model="ir.ui.view">
            <field name="name">patient.vital.sign.search</field>
            <field name="model">patient.vital.sign</field>
            <field name="arch" type="xml">
                <search string="Search Vital Signs">
                    <field name="type"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_vital_sign" model="ir.actions.act_window">
            <field name="name">Vital Signs</field>
            <field name="res_model">patient.vital.sign</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new vital sign type
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_vital_sign_root" 
                  name="Vital Signs" 
                  sequence="30"/>
        
        <menuitem id="menu_vital_sign_main" 
                  name="Vital Sign Types" 
                  parent="menu_vital_sign_root" 
                  action="action_vital_sign" 
                  sequence="10"/>

    </data>
</odoo>