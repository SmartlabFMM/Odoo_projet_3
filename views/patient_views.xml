<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_patient_form" model="ir.ui.view">
        <field name="name">patient.monitoring.patient.form</field>
        <field name="model">patient.monitoring.patient</field>
        <field name="arch" type="xml">
            <form string="Patient" class="hm_patient_form">
                <header>
                    <button name="action_start_stream"
                            string="Start Stream"
                            type="object"
                            class="btn-primary"
                            invisible="stream_running"/>
                    <button name="action_stop_stream"
                            string="Stop Stream"
                            type="object"
                            class="btn-danger"
                            invisible="not stream_running"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_medical_records" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="medical_record_count" widget="statinfo" string="Records"/>
                        </button>
                        <button name="action_view_measurements" type="object"
                                class="oe_stat_button" icon="fa-heartbeat">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        <button name="action_view_alerts" type="object"
                                class="oe_stat_button" icon="fa-bell">
                            <field name="active_alert_count" widget="statinfo" string="Recorded Alerts"/>
                        </button>
                        <button name="action_start_stream" type="object"
                                class="oe_stat_button" icon="fa-video-camera"
                                invisible="stream_running">
                            <div class="o_stat_info">
                                <span class="o_stat_value">Offline</span>
                                <span class="o_stat_text">Stream</span>
                            </div>
                        </button>
                        <button name="action_stop_stream" type="object"
                                class="oe_stat_button o_pm_stream_live_btn" icon="fa-video-camera"
                                invisible="not stream_running">
                            <div class="o_stat_info">
                                <span class="o_stat_value o_pm_live_label">Live</span>
                                <span class="o_stat_text">Stream</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="first_name" placeholder="First Name"/>
                            <field name="last_name" placeholder="Last Name"/>
                        </h1>
                        <h3><field name="patient_ref" readonly="1"/></h3>
                    </div>

                    <group>
                        <group string="Personal Information">
                            <field name="date_of_birth"/>
                            <field name="age"/>
                            <field name="sex"/>
                            <field name="phone_number"/>
                            <field name="email"/>
                        </group>
                        <group string="Medical Information">
                            <field name="assigned_staff_id"/>
                            <field name="admission_date"/>
                            <field name="discharge_date"/>
                            <field name="emergency_contact"/>
                            <field name="emergency_phone"/>
                        </group>
                    </group>

                    <group string="Address">
                        <field name="address" nolabel="1"/>
                    </group>

                    <group string="Camera and Stream">
                        <group>
                            <field name="has_consented"
                                   widget="boolean_toggle"
                                   string="Patient Consent"
                                   help="The patient has given informed consent for remote monitoring and video streaming."/>
                            <field name="camera_url"
                                   placeholder="rtsp://192.168.1.x:554/stream"
                                   readonly="stream_running"
                                   help="RTSP / HTTP stream URL for this patient's bedside camera, e.g. rtsp://192.168.1.10:554/stream"/>
                            <field name="stream_running" invisible="1"/>
                            <label string="Stream Status" for="stream_running"/>
                            <div>
                                <span class="fw-bold text-success"
                                      invisible="not stream_running">ONLINE</span>
                                <span class="text-muted"
                                      invisible="stream_running">OFFLINE</span>
                            </div>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_patient_tree" model="ir.ui.view">
        <field name="name">patient.monitoring.patient.tree</field>
        <field name="model">patient.monitoring.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="patient_ref"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="age"/>
                <field name="sex"/>
                <field name="assigned_staff_id"/>
                <field name="admission_date"/>
                <field name="stream_running" widget="boolean_toggle" string="Stream" readonly="1"/>
                <field name="active_alert_count" string="Active Alerts"/>
            </list>
        </field>
    </record>

    <record id="view_patient_kanban" model="ir.ui.view">
        <field name="name">patient.monitoring.patient.kanban</field>
        <field name="model">patient.monitoring.patient</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="name"/>
                <field name="patient_ref"/>
                <field name="age"/>
                <field name="sex"/>
                <field name="active_alert_count"/>
                <field name="assigned_staff_id"/>
                <field name="stream_running"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_title">
                            <strong><field name="name"/></strong>
                            <small class="text-muted ms-2"><field name="patient_ref"/></small>
                        </div>
                        <div>Age: <field name="age"/> | <field name="sex"/></div>
                        <div>Staff: <field name="assigned_staff_id"/></div>
                        <div t-if="record.stream_running.raw_value" class="text-success fw-bold">
                            🔴 Stream Live
                        </div>
                        <div t-if="record.active_alert_count.raw_value > 0" class="text-danger">
                            <field name="active_alert_count"/> Active Alert(s)
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_patient_search" model="ir.ui.view">
        <field name="name">patient.monitoring.patient.search</field>
        <field name="model">patient.monitoring.patient</field>
        <field name="arch" type="xml">
            <search string="Search Patients">
                <field name="name"/>
                <field name="first_name"/>
                <field name="last_name"/>
                <field name="patient_ref"/>
                <field name="assigned_staff_id"/>
                <filter name="stream_live" string="Stream Live" domain="[('stream_running','=',True)]"/>
                <filter name="group_staff" string="Assigned Staff" context="{'group_by':'assigned_staff_id'}"/>
                <filter name="group_sex" string="Sex" context="{'group_by':'sex'}"/>
            </search>
        </field>
    </record>

    <record id="action_patient_list" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">patient.monitoring.patient</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_patient_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first patient!</p>
        </field>
    </record>

    <delete model="ir.actions.act_window" id="action_patient"/>

    <record id="action_patient" model="ir.actions.client">
        <field name="name">Patients</field>
        <field name="tag">health_monitoring.patient_dashboard</field>
    </record>

</odoo>