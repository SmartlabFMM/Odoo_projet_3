<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Tree View -->
        <record id="view_patient_tree" model="ir.ui.view">
            <field name="name">patient.patient.tree</field>
            <field name="model">patient.patient</field>
            <field name="arch" type="xml">
                <list string="Patients">
                    <field name="medical_record_number"/>
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="date_of_birth"/>
                    <field name="age"/>
                    <field name="sex"/>
                    <field name="phone_number"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_patient_form" model="ir.ui.view">
            <field name="name">patient.patient.form</field>
            <field name="model">patient.patient</field>
            <field name="arch" type="xml">
                <form string="Patient">
                    <sheet>
                        <group>
                            <group string="Patient Information">
                                <field name="medical_record_number"/>
                                <field name="first_name"/>
                                <field name="last_name"/>
                            </group>
                            <group string="Demographics">
                                <field name="date_of_birth"/>
                                <field name="age"/>
                                <field name="sex"/>
                            </group>
                        </group>
                        <group string="Contact Information">
                            <field name="phone_number"/>
                            <field name="address"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_patient_search" model="ir.ui.view">
            <field name="name">patient.patient.search</field>
            <field name="model">patient.patient</field>
            <field name="arch" type="xml">
                <search string="Search Patients">
                    <field name="medical_record_number"/>
                    <field name="first_name"/>
                    <field name="last_name"/>
                    <field name="phone_number"/>
                    <filter string="Male" name="male" domain="[('sex', '=', 'male')]"/>
                    <filter string="Female" name="female" domain="[('sex', '=', 'female')]"/>
                    <separator/>
                    <filter string="Sex" name="group_by_sex" context="{'group_by': 'sex'}"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">patient.patient</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new patient record
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_patient_root" 
                  name="Patients" 
                  sequence="10"/>
        
        <menuitem id="menu_patient_main" 
                  name="Patients" 
                  parent="menu_patient_root" 
                  action="action_patient" 
                  sequence="10"/>

    </data>
</odoo>