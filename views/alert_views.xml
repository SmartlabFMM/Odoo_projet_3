<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Tree View -->
        <record id="view_alerts_tree" model="ir.ui.view">
            <field name="name">patient.alerts.tree</field>
            <field name="model">patient.alerts</field>
            <field name="arch" type="xml">
                <list string="Alerts">
                    <field name="timestamp"/>
                    <field name="severity"/>
                    <field name="message"/>
                    <field name="acknowledged"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_alerts_form" model="ir.ui.view">
            <field name="name">patient.alerts.form</field>
            <field name="model">patient.alerts</field>
            <field name="arch" type="xml">
                <form string="Alert">
                    <sheet>
                        <group>
                            <group string="Alert Information">
                                <field name="timestamp"/>
                                <field name="severity"/>
                                <field name="message"/>
                                <field name="acknowledged"/>
                                <field name="acknowledged_at"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_alerts_search" model="ir.ui.view">
            <field name="name">patient.alerts.search</field>
            <field name="model">patient.alerts</field>
            <field name="arch" type="xml">
                <search string="Search Alerts">
                    <field name="timestamp"/>
                    <field name="severity"/>
                    <filter string="Unacknowledged" name="unacknowledged" domain="[('acknowledged', '=', False)]"/>
                    <filter string="Acknowledged" name="acknowledged" domain="[('acknowledged', '=', True)]"/>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_alerts" model="ir.actions.act_window">
            <field name="name">Alerts</field>
            <field name="res_model">patient.alerts</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new alert record
                </p>
            </field>
        </record>

        <!-- Menu Items -->
        <menuitem id="menu_alerts_root" 
                  name="Alerts" 
                  sequence="50"/>
        
        <menuitem id="menu_alerts_main" 
                  name="Patient Alerts" 
                  parent="menu_alerts_root" 
                  action="action_alerts" 
                  sequence="10"/>

    </data>
</odoo>